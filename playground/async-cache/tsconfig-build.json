{
  "exclude": ["**/__tests__/*"],
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "module": "esnext",
    "outDir": "dist/esm",
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022"
  }
}
